{
  "rewrites": [
    { "source": "/venue/:id", "destination": "/api/venue?id=:id" },
    { "source": "/event/:id", "destination": "/api/event?id=:id" },
    { "source": "/u/:username", "destination": "/api/profile?username=:username" }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    }
  ]
}